{
   "routes":[
      {
         "route":"/admin*",
         "allowedRoles":[
            "authenticated"
         ]
      },
      {
         "route":"/api/*",
         "methods":[
            "GET"
         ]
      }
   ],
   "navigationFallback":{
      "rewrite":"/index.html",
      "exclude":[
         "/images/*.png",
         "/css/*"
      ]
   },
   "responseOverrides":{
      "404":{
         "rewrite":"/index.html",
         "statusCode":200
      }
   }
}